<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NODE_ENV</key>
		<string>production</string>
		<key>PATH</key>
		<string>__NODE_BIN__:/usr/local/bin:/usr/bin:/bin</string>
		<key>TZ</key>
		<string>Europe/Istanbul</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.artriyum.abonelik.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE_BIN__/node</string>
		<string>__PROJECT_DIR__/node_modules/next/dist/bin/next</string>
		<string>start</string>
		<string>-p</string>
		<string>3000</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/logs/server.err.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/logs/server.log</string>
	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>
</dict>
</plist>
