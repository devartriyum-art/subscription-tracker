<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TZ</key>
		<string>Europe/Istanbul</string>
	</dict>
	<key>Label</key>
	<string>com.artriyum.abonelik.daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__PROJECT_DIR__/ops/daily.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/logs/daily.err.log</string>
	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/logs/daily.out.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__</string>
</dict>
</plist>
